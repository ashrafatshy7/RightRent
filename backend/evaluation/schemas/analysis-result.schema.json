{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rightrent.local/schemas/analysis-result.schema.json",
  "title": "RightRent Analysis Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "contractId",
    "status",
    "summary",
    "headline",
    "keyFindingIds",
    "findings",
    "crossClauseIssues",
    "clauseLinking",
    "protectionReport",
    "financialTerms",
    "missingProtections",
    "suggestedAdditions",
    "preferencesSnapshot",
    "analysisInputHash",
    "privacy",
    "disclaimer",
    "markedPdf",
    "createdAt",
    "timingMs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.4.0" },
    "analysisId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "contractId": { "type": "string", "minLength": 1 },
    "status": { "const": "COMPLETED" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "warnings", "compliant"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "compliant": { "type": "integer", "minimum": 0 }
      }
    },
    "headline": { "type": "string", "minLength": 1 },
    "keyFindingIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "crossClauseIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "clauseIds", "explanation", "severity"],
        "properties": {
          "kind": { "$ref": "#/$defs/crossClauseIssueKind" },
          "clauseIds": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
          "explanation": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["RED", "ORANGE", "OK"] }
        }
      }
    },
    "clauseLinking": { "type": "boolean" },
    "financialTerms": { "$ref": "#/$defs/financialTerms" },
    "protectionReport": {
      "type": "array",
      "items": { "$ref": "#/$defs/protection" }
    },
    "missingProtections": {
      "type": "array",
      "items": { "$ref": "#/$defs/protection" }
    },
    "suggestedAdditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/protection" }
    },
    "preferencesSnapshot": { "$ref": "#/$defs/preferences" },
    "analysisInputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redactionCompleted", "redactedEntityCount", "mode", "model"],
      "properties": {
        "redactionCompleted": { "type": "boolean" },
        "redactedEntityCount": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["REGEX_TEST_ONLY", "REGEX_AND_DICTABERT"] },
        "model": { "type": ["string", "null"] }
      }
    },
    "disclaimer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notLegalAdvice", "humanReviewRecommended"],
      "properties": {
        "notLegalAdvice": { "const": true },
        "humanReviewRecommended": { "const": true }
      }
    },
    "markedPdf": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["storageKey"],
          "properties": {
            "storageKey": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "timingMs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "target", "targetMet"],
      "properties": {
        "extraction": { "type": "integer", "minimum": 0 },
        "redaction": { "type": "integer", "minimum": 0 },
        "retrievalAndAnalysis": { "type": "integer", "minimum": 0 },
        "pdfGeneration": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "target": { "type": "integer", "minimum": 1 },
        "targetMet": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clauseId",
        "severity",
        "category",
        "topic",
        "confidence",
        "title",
        "clauseQuote",
        "plainLanguageExplanation",
        "whyItMatters",
        "explanation",
        "legalAssessment",
        "legalReferences",
        "relatedFindingIds",
        "locations"
      ],
      "properties": {
        "clauseId": { "type": "string", "minLength": 1 },
        "sectionLabel": { "type": "string", "minLength": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["RED", "ORANGE", "OK"] },
        "category": {
          "enum": ["legal_compliance", "contractual_risk", "tenant_preference", "informational"]
        },
        "topic": {
          "enum": [
            "rent_and_term",
            "guarantee_security",
            "entry_privacy",
            "repairs_maintenance",
            "charges_payments",
            "termination_renewal",
            "waiver_liability",
            "pets_and_use",
            "handover_condition",
            "other"
          ]
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "title": { "type": "string", "minLength": 1 },
        "clauseQuote": { "type": "string", "minLength": 1 },
        "plainLanguageExplanation": { "type": "string", "minLength": 1 },
        "whyItMatters": { "type": "string", "minLength": 1 },
        "recommendedAction": { "type": "string", "minLength": 1 },
        "suggestedReplacementText": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "legalAssessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["violatesLaw", "riskWarning", "preferenceConflict"],
          "properties": {
            "violatesLaw": { "type": "boolean" },
            "riskWarning": { "type": "boolean" },
            "preferenceConflict": { "type": "boolean" }
          }
        },
        "legalReferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/legalReference" }
        },
        "deterministicChecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/deterministicCheck" }
        },
        "relatedFindingIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "contextClauses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["clauseId", "relation", "reason", "usedInAnalysis"],
            "properties": {
              "clauseId": { "type": "string", "minLength": 1 },
              "relation": {
                "enum": [
                  "SAME_SECTION",
                  "REFERENCES",
                  "REFERENCED_BY",
                  "OVERRIDES",
                  "OVERRIDDEN_BY",
                  "DEFINES_VALUE",
                  "RELATED_TOPIC",
                  "SIMILAR_TEXT"
                ]
              },
              "reason": { "type": "string", "minLength": 1 },
              "usedInAnalysis": { "type": "boolean" }
            }
          }
        },
        "crossClauseIssue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "clauseIds", "explanation"],
          "properties": {
            "kind": { "$ref": "#/$defs/crossClauseIssueKind" },
            "clauseIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "explanation": { "type": "string", "minLength": 1 }
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "bbox"],
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "bbox": {
                "type": "array",
                "prefixItems": [
                  { "type": "number" },
                  { "type": "number" },
                  { "type": "number", "exclusiveMinimum": 0 },
                  { "type": "number", "exclusiveMinimum": 0 }
                ],
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protectionId", "title", "status", "explanation", "relevantClauseIds", "legalReferences"],
      "properties": {
        "protectionId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["COVERED", "MISSING", "PARTIAL"] },
        "explanation": { "type": "string", "minLength": 1 },
        "relevantClauseIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "legalReferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/legalReference" }
        },
        "suggestedText": { "type": "string" }
      }
    },
    "legalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lawReferenceId", "lawName", "section", "sourceUrl", "revisionId", "excerpt", "sourceAsOf"],
      "properties": {
        "lawReferenceId": { "type": "string", "minLength": 1 },
        "lawName": { "type": "string", "minLength": 1 },
        "section": { "type": ["string", "null"] },
        "sourceUrl": { "type": "string", "format": "uri" },
        "revisionId": { "type": ["integer", "null"] },
        "excerpt": { "type": ["string", "null"] },
        "sourceAsOf": { "type": ["string", "null"] }
      }
    },
    "deterministicCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "label",
        "legalReferenceId",
        "contractValue",
        "legalLimit",
        "calculatedLimit",
        "difference",
        "unit",
        "passesRule"
      ],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "legalReferenceId": { "type": "string", "minLength": 1 },
        "contractValue": { "type": "number" },
        "legalLimit": { "type": "number" },
        "calculatedLimit": { "type": "number" },
        "difference": { "type": "number" },
        "unit": { "enum": ["ILS", "days"] },
        "passesRule": { "type": "boolean" },
        "formula": { "type": "string", "minLength": 1 },
        "sourceClauseIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "crossClauseIssueKind": { "enum": ["CONFLICT", "OVERRIDE", "COMBINED_EFFECT"] },
    "termSource": {
      "type": "object",
      "required": ["clauseId", "quote", "verified", "origin"],
      "properties": {
        "clauseId": { "type": "string", "minLength": 1 },
        "quote": { "type": "string" },
        "verified": { "type": "boolean" },
        "origin": { "enum": ["RULE", "MODEL"] },
        "conflict": { "type": "boolean" }
      }
    },
    "sourcedNumber": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/termSource" }],
      "required": ["value"],
      "properties": { "value": { "type": "number" } }
    },
    "financialTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthlyRent",
        "leaseTermMonths",
        "leaseStart",
        "indexation",
        "annualIncreasePercent",
        "option",
        "charges",
        "oneTimeCosts",
        "securities",
        "lateVacating",
        "latePayment",
        "earlyExit",
        "unknowns"
      ],
      "properties": {
        "monthlyRent": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sourcedNumber" }] },
        "leaseTermMonths": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sourcedNumber" }] },
        "leaseStart": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "allOf": [{ "$ref": "#/$defs/termSource" }], "required": ["value"], "properties": { "value": { "type": "string", "format": "date" } } }
          ]
        },
        "indexation": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "allOf": [{ "$ref": "#/$defs/termSource" }],
              "required": ["index", "frequency", "floorAtBase"],
              "properties": {
                "index": { "enum": ["CPI", "USD", "OTHER"] },
                "frequency": { "enum": ["MONTHLY", "ANNUAL", "AT_RENEWAL", "UNKNOWN"] },
                "floorAtBase": { "type": "boolean" }
              }
            }
          ]
        },
        "annualIncreasePercent": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sourcedNumber" }] },
        "option": {
          "type": "object",
          "additionalProperties": false,
          "required": ["months", "rent", "increasePercent"],
          "properties": {
            "months": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sourcedNumber" }] },
            "rent": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sourcedNumber" }] },
            "increasePercent": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sourcedNumber" }] }
          }
        },
        "charges": {
          "type": "array",
          "items": {
            "type": "object", "allOf": [{ "$ref": "#/$defs/termSource" }],
            "required": ["kind", "payer", "monthlyAmount"],
            "properties": {
              "kind": { "enum": ["ARNONA", "WATER", "ELECTRICITY", "GAS", "VAAD_BAYIT", "BUILDING_INSURANCE", "SPECIAL_BUILDING_EXPENSES", "CONTENTS_INSURANCE", "OTHER"] },
              "payer": { "enum": ["TENANT", "LANDLORD"] },
              "monthlyAmount": { "type": ["number", "null"] }
            }
          }
        },
        "oneTimeCosts": {
          "type": "array",
          "items": {
            "type": "object", "allOf": [{ "$ref": "#/$defs/termSource" }],
            "required": ["kind", "amount", "timing"],
            "properties": {
              "kind": { "enum": ["BROKER_FEE", "LEGAL_FEE", "CLEANING", "OTHER"] },
              "amount": { "type": ["number", "null"] },
              "timing": { "enum": ["START", "END"] }
            }
          }
        },
        "securities": {
          "type": "array",
          "items": {
            "type": "object", "allOf": [{ "$ref": "#/$defs/termSource" }],
            "required": ["kind", "amount", "returnDays"],
            "properties": {
              "kind": { "enum": ["BANK_GUARANTEE", "CASH_DEPOSIT", "PROMISSORY_NOTE", "GUARANTOR", "OTHER"] },
              "amount": { "type": ["number", "null"] },
              "returnDays": { "type": ["number", "null"] }
            }
          }
        },
        "lateVacating": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "allOf": [{ "$ref": "#/$defs/termSource" }], "required": ["perDay", "dailyRentMultiple"], "properties": { "perDay": { "type": ["number", "null"] }, "dailyRentMultiple": { "type": ["number", "null"] } } }
          ]
        },
        "latePayment": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "allOf": [{ "$ref": "#/$defs/termSource" }], "required": ["perDay", "monthlyInterestPercent"], "properties": { "perDay": { "type": ["number", "null"] }, "monthlyInterestPercent": { "type": ["number", "null"] } } }
          ]
        },
        "earlyExit": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "allOf": [{ "$ref": "#/$defs/termSource" }],
              "required": ["kind", "months", "amount", "noticeDays"],
              "properties": {
                "kind": { "enum": ["UNTIL_REPLACEMENT", "UNTIL_END", "FIXED_MONTHS", "FIXED_AMOUNT", "ALLOWED_WITH_NOTICE", "NOT_ALLOWED"] },
                "months": { "type": ["number", "null"] },
                "amount": { "type": ["number", "null"] },
                "noticeDays": { "type": ["number", "null"] }
              }
            }
          ]
        },
        "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxMonthlyRentIls",
        "repairUrgencyHours",
        "leaseLengthMonths",
        "maxAnnualRentIncreasePercent",
        "petsRequired",
        "furnishedRequired",
        "acceptsGuarantorRequirement"
      ],
      "properties": {
        "maxMonthlyRentIls": { "type": "number", "minimum": 0 },
        "repairUrgencyHours": { "enum": [24, 48, 72, 168] },
        "leaseLengthMonths": { "type": "integer", "minimum": 1 },
        "maxAnnualRentIncreasePercent": { "type": "number", "minimum": 0 },
        "petsRequired": { "type": "boolean" },
        "furnishedRequired": { "type": "boolean" },
        "acceptsGuarantorRequirement": { "type": "boolean" }
      }
    }
  }
}
