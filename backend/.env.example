NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=86400
BCRYPT_ROUNDS=12
REQUEST_LIMIT_PER_MINUTE=120
ADMIN_EMAILS=admin@example.com

DATA_DRIVER=mongodb
MONGODB_URI=mongodb+srv://user:password@example.mongodb.net/
MONGODB_DATABASE=rightrent
MONGODB_VECTOR_INDEX=law_vector_index
MONGODB_MANAGE_VECTOR_INDEX=true

ANALYSIS_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required before ANALYSIS_PROVIDER can be changed to anthropic.
PII_NER_MODE=regex
PII_NER_ENDPOINT=http://127.0.0.1:8001
PII_NER_TOKEN=replace-with-a-long-random-sidecar-token
PII_NER_MODEL=dicta-il/dictabert-ner
PII_NER_MINIMUM_CONFIDENCE=0.8
PII_NER_TIMEOUT_MS=30000

OCR_LANGUAGE=heb+eng
UPLOAD_DIR=storage/uploads
MARKED_PDF_DIR=storage/marked-pdfs
INTERNAL_API_TOKEN=replace-with-a-long-random-internal-token
LAW_SYNC_RETENTION_DAYS=90
LAW_SYNC_LEASE_MINUTES=55
ANALYSIS_TARGET_MS=90000
